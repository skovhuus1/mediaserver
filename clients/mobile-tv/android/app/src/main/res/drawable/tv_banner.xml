<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#090D12" android:endColor="#22113D" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:left="22dp" android:top="22dp" android:right="250dp" android:bottom="22dp">
        <shape android:shape="oval">
            <gradient android:angle="45" android:startColor="#8B5CF6" android:endColor="#43E7C4" />
        </shape>
    </item>
</layer-list>
