model LiveTvProvider {
  id                 String             @id @default(uuid())
  accountId          String             @map("account_id")
  name               String
  enabled            Boolean            @default(true)
  priority           Int                @default(100)
  perUserStreamLimit Int                @default(1) @map("per_user_stream_limit")
  autoRefreshEnabled Boolean            @default(true) @map("auto_refresh_enabled")
  playlistRefreshMinutes Int            @default(60) @map("playlist_refresh_minutes")
  epgRefreshMinutes      Int            @default(360) @map("epg_refresh_minutes")
  lastPlaylistQueuedAt   DateTime?      @map("last_playlist_queued_at")
  lastEpgQueuedAt        DateTime?      @map("last_epg_queued_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  account            Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  connections        LiveTvConnection[]
  epgSource          LiveTvEpgSource?
  programs           LiveTvProgram[]

  @@unique([accountId, name])
  @@index([accountId, enabled, priority])
  @@index([accountId, enabled, autoRefreshEnabled])
  @@map("live_tv_providers")
}

model LiveTvConnection {
  id                   String                @id @default(uuid())
  accountId            String                @map("account_id")
  providerId           String                @map("provider_id")
  name                 String
  playlistUrl          Json                  @map("playlist_url")
  playlistFingerprint String                @map("playlist_fingerprint")
  enabled              Boolean               @default(true)
  priority             Int                   @default(100)
  maxConcurrentStreams Int                   @default(1) @map("max_concurrent_streams")
  healthStatus         String                @default("unknown") @map("health_status")
  lastError            String?               @map("last_error")
  lastImportedAt       DateTime?             @map("last_imported_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  account              Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  provider             LiveTvProvider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  sources              LiveTvChannelSource[]
  leases               LiveTvLease[]
  recordings           LiveTvRecording[]

  @@unique([providerId, playlistFingerprint])
  @@index([accountId, enabled, priority])
  @@map("live_tv_connections")
}

model LiveTvChannel {
  id             String                @id @default(uuid())
  accountId      String                @map("account_id")
  canonicalKey   String                @map("canonical_key")
  tvgId          String?               @map("tvg_id")
  name           String
  number         Int?
  logoUrl        String?               @map("logo_url")
  groupName      String?               @map("group_name")
  enabled        Boolean               @default(true)
  isAdult        Boolean               @default(false) @map("is_adult")
  metadataLocked Boolean               @default(false) @map("metadata_locked")
  sortOrder      Int                   @default(0) @map("sort_order")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  account        Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sources        LiveTvChannelSource[]
  programs       LiveTvProgram[]
  leases         LiveTvLease[]
  favorites      LiveTvFavorite[]
  recordings     LiveTvRecording[]

  @@unique([accountId, canonicalKey])
  @@index([accountId, enabled, groupName, sortOrder])
  @@index([accountId, tvgId])
  @@map("live_tv_channels")
}

model LiveTvChannelSource {
  id                 String           @id @default(uuid())
  channelId          String           @map("channel_id")
