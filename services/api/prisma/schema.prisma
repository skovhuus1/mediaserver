generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  active
  suspended
  disabled
}

enum UserStatus {
  active
  suspended
  deleted
}

enum SubscriptionStatus {
  pending
  trialing
  active
  past_due
  grace_period
  paused
  canceled
  expired
  suspended
}

enum PlaybackSessionStatus {
  reserving
  active
  paused
  stopping
  completed
  disconnected
  expired
  terminated_by_admin
  failed
  user_stopped
}

enum LibraryType {
  movie
  series
  home_video
}

enum MediaType {
  movie
  episode
}

model accounts {
  id           String        @id @default(uuid())
  name         String
  server_name  String        @default("BoltBytes Media")
  external_url String?
  language     String        @default("en")
  timezone     String        @default("Europe/Copenhagen")
  status       AccountStatus @default(active)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  users             users[]
  profiles          profiles[]
  devices           devices[]
  storage_roots     storage_roots[]
  subscriptions     subscriptions[]
  libraries         libraries[]
  media_items       media_items[]
  playback_sessions playback_sessions[]
  playback_history  playback_history[]
  audit_logs        audit_logs[]
  system_settings   system_settings[]
  refresh_tokens    refresh_tokens[]

  @@map("accounts")
}

model users {
  id             String      @id @default(uuid())
  account_id     String
  email          String
  password_hash  String
  display_name   String
  status         UserStatus  @default(active)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  accounts        accounts                 @relation(fields: [account_id], references: [id], onDelete: Cascade)
  profiles        profiles[]
  user_roles      user_roles[]
  devices         devices[]
  refresh_tokens  refresh_tokens[]
  subscriptions   subscriptions[]
  user_entitlement_overrides user_entitlement_overrides[]
  playback_sessions playback_sessions[]
  playback_history playback_history[]
  audit_logs      audit_logs[]

  @@index([account_id])
  @@unique([account_id, email])
  @@index([account_id, email])
  @@map("users")
}

model profiles {
  id                  String   @id @default(uuid())
  account_id          String
  user_id             String?
  name                String
  is_child_profile    Boolean  @default(false)
  pin_hash            String?
  language            String   @default("en")
  subtitle_preference String   @default("default")
  audio_preference    String   @default("default")
  quality_profile     String   @default("auto")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  accounts         accounts    @relation(fields: [account_id], references: [id], onDelete: Cascade)
  users            users?      @relation(fields: [user_id], references: [id], onDelete: SetNull)
  playback_sessions playback_sessions[]
  playback_history  playback_history[]

  @@index([account_id])
  @@index([user_id])
  @@map("profiles")
}

model roles {
  id               String             @id @default(uuid())
  code             String             @unique
  description      String?
  created_at       DateTime           @default(now())
  user_roles       user_roles[]
  role_permissions role_permissions[]

  @@map("roles")
}

model permissions {
  id               String             @id @default(uuid())
  code             String             @unique
  description      String?
  created_at       DateTime           @default(now())
  role_permissions role_permissions[]

  @@map("permissions")
}

model role_permissions {
  id            String @id @default(uuid())
  role_id       String
  permission_id String
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

model user_roles {
  id      String @id @default(uuid())
  user_id String
  role_id String
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  roles   roles  @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@map("user_roles")
}

model devices {
  id              String   @id @default(uuid())
  account_id      String
  user_id         String
  device_name     String
  device_type     String
  platform        String?
  app_version     String?
  first_seen_at   DateTime @default(now())
  last_seen_at    DateTime @default(now())
  last_ip_address String?
  is_trusted      Boolean  @default(false)
  is_revoked      Boolean  @default(false)
  capabilities    Json

  accounts          accounts       @relation(fields: [account_id], references: [id], onDelete: Cascade)
  users             users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  playback_sessions playback_sessions[]
  refresh_tokens    refresh_tokens[]

  @@unique([account_id, device_name])
  @@index([account_id])
  @@index([user_id])
  @@map("devices")
}

model refresh_tokens {
  id           String   @id @default(uuid())
  token_hash   String   @unique
  user_id      String
  account_id   String
  device_id    String
  family_id    String
  revoked_at   DateTime?
  expires_at   DateTime
  created_at   DateTime @default(now())
  last_used_at DateTime?

  users     users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  accounts  accounts @relation(fields: [account_id], references: [id], onDelete: Cascade)
  devices   devices  @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([account_id])
  @@index([user_id])
  @@index([device_id])
  @@map("refresh_tokens")
}

model plans {
  id                 String    @id @default(uuid())
  name               String
  internal_code      String    @unique
  description        String?
  is_active          Boolean   @default(true)
  is_public          Boolean   @default(false)
  price              Decimal   @default(0) @db.Decimal(12, 2)
  currency           String    @default("USD")
  billing_interval   String    @default("monthly")
  trial_days         Int       @default(0)
  grace_period_days  Int       @default(0)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  plan_versions      plan_versions[]

  @@map("plans")
}

model plan_versions {
  id                       String      @id @default(uuid())
  plan_id                  String
  version_number           Int
  is_active                Boolean     @default(false)
  effective_at             DateTime    @default(now())
  max_concurrent_streams   Int         @default(1)
  max_registered_devices   Int         @default(1)
  max_offline_downloads    Int         @default(0)
  max_video_resolution     Int?        @default(1080)
  max_video_bitrate        Int?        @default(4000)
  max_audio_channels       Int?        @default(2)
  allow_direct_play        Boolean     @default(true)
  allow_direct_stream      Boolean     @default(false)
  allow_video_transcode    Boolean     @default(false)
  allow_audio_transcode    Boolean     @default(false)
  allow_subtitle_burn_in   Boolean     @default(false)
  allow_remote_streaming   Boolean     @default(true)
  allow_offline_downloads  Boolean     @default(false)
  allow_chromecast         Boolean     @default(false)
  allow_hdr                Boolean     @default(false)
  allow_dolby_vision       Boolean     @default(false)
  allow_lossless_audio     Boolean     @default(false)
  release_delay_months     Int         @default(0)
  release_delay_days       Int         @default(0)
  snapshot                 Json

  plans             plans          @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  subscriptions     subscriptions[]
  plan_entitlements plan_entitlements?

  @@unique([plan_id, version_number])
  @@map("plan_versions")
}

model plan_entitlements {
  id             String   @id @default(uuid())
  plan_version_id String   @unique
  snapshot       Json
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  plan_versions  plan_versions @relation(fields: [plan_version_id], references: [id], onDelete: Cascade)

  @@map("plan_entitlements")
}

model subscriptions {
  id               String             @id @default(uuid())
  account_id       String
  user_id          String?
  plan_version_id  String
  status           SubscriptionStatus @default(pending)
  starts_at        DateTime           @default(now())
  ends_at          DateTime?
  suspended_until  DateTime?
  suspended_reason String?
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  snapshot_at      DateTime?

  accounts      accounts      @relation(fields: [account_id], references: [id], onDelete: Cascade)
  users         users?        @relation(fields: [user_id], references: [id], onDelete: SetNull)
  plan_versions plan_versions @relation(fields: [plan_version_id], references: [id], onDelete: Restrict)
  snapshot      subscription_snapshots?
  events        subscription_events[]

  @@index([account_id])
  @@index([plan_version_id])
  @@index([status])
  @@map("subscriptions")
}

model subscription_events {
  id              String   @id @default(uuid())
  subscription_id String
  event_type      String
  event_payload   Json
  created_at      DateTime @default(now())

  subscriptions   subscriptions @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@index([subscription_id])
  @@map("subscription_events")
}

model subscription_snapshots {
  id              String   @id @default(uuid())
  subscription_id String   @unique
  snapshot        Json
  created_at      DateTime @default(now())

  subscriptions   subscriptions @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@map("subscription_snapshots")
}

model user_entitlement_overrides {
  id         String   @id @default(uuid())
  account_id String
  user_id    String
  overrides  Json
  granted_at DateTime @default(now())
  expires_at DateTime?

  accounts   accounts @relation(fields: [account_id], references: [id], onDelete: Cascade)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([account_id])
  @@index([user_id])
  @@index([expires_at])
  @@map("user_entitlement_overrides")
}

model storage_roots {
  id         String   @id @default(uuid())
  account_id String
  label      String
  mount_path String
  type       String   @default("local")
  is_readonly Boolean @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  accounts  accounts    @relation(fields: [account_id], references: [id], onDelete: Cascade)
  libraries libraries[]

  @@index([account_id])
  @@map("storage_roots")
}

model libraries {
  id             String      @id @default(uuid())
  account_id     String
  storage_root_id String
  name           String
  type           LibraryType @default(movie)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  accounts       accounts      @relation(fields: [account_id], references: [id], onDelete: Cascade)
  storage_roots  storage_roots @relation(fields: [storage_root_id], references: [id], onDelete: Cascade)
  library_paths  library_paths[]
  media_items    media_items[]

  @@index([account_id])
  @@index([storage_root_id])
  @@map("libraries")
}

model library_paths {
  id              String   @id @default(uuid())
  library_id      String
  path            String
  recursive       Boolean  @default(true)
  include_patterns Json?
  exclude_patterns Json?

  libraries       libraries @relation(fields: [library_id], references: [id], onDelete: Cascade)

  @@index([library_id])
  @@map("library_paths")
}

model media_items {
  id                    String    @id @default(uuid())
  account_id            String
  library_id            String
  title                 String
  description           String?
  media_type            MediaType
  metadata_release_date DateTime?
  original_release_date DateTime?
  digital_release_date  DateTime?
  physical_release_date DateTime?
  first_air_date        DateTime?
  availability_date     DateTime?
  availability_override DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  accounts          accounts         @relation(fields: [account_id], references: [id], onDelete: Cascade)
  libraries         libraries        @relation(fields: [library_id], references: [id], onDelete: Cascade)
  playback_history   playback_history[]
  playback_sessions playback_sessions[]

  @@index([account_id])
  @@index([library_id])
  @@index([media_type])
  @@map("media_items")
}

model playback_sessions {
  id                 String               @id @default(uuid())
  account_id         String
  profile_id         String
  user_id            String
  device_id          String
  media_id           String
  media_source_id    String?
  playback_method    String
  stream_token       String
  started_at         DateTime             @default(now())
  last_heartbeat_at  DateTime?
  lease_expires_at   DateTime
  ended_at           DateTime?
  status             PlaybackSessionStatus @default(reserving)
  is_local           Boolean              @default(false)
  is_cast_session    Boolean              @default(false)
  ip_address         String?
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt

  accounts          accounts          @relation(fields: [account_id], references: [id], onDelete: Cascade)
  profiles          profiles          @relation(fields: [profile_id], references: [id], onDelete: Restrict)
  users             users             @relation(fields: [user_id], references: [id], onDelete: Restrict)
  devices           devices           @relation(fields: [device_id], references: [id], onDelete: Restrict)
  media_items       media_items       @relation(fields: [media_id], references: [id], onDelete: Restrict)
  stream_reservations stream_reservations[]
  playback_history   playback_history[]

  @@index([account_id])
  @@index([user_id])
  @@index([status])
  @@index([lease_expires_at])
  @@map("playback_sessions")
}

model stream_reservations {
  id                  String   @id @default(uuid())
  playback_session_id  String   @unique
  account_id          String
  device_id           String
  media_id            String
  reserved_at         DateTime @default(now())
  started_at          DateTime?
  released_at         DateTime?
  reason              String?

  playback_sessions   playback_sessions @relation(fields: [playback_session_id], references: [id], onDelete: Cascade)

  @@index([account_id])
  @@index([device_id])
  @@map("stream_reservations")
}

model playback_history {
  id                 String    @id @default(uuid())
  account_id         String
  profile_id         String
  user_id            String
  playback_session_id String
  media_id           String?
  device_id          String
  position_ms        Int       @default(0)
  played_ms          Int       @default(0)
  completed          Boolean   @default(false)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  accounts         accounts         @relation(fields: [account_id], references: [id], onDelete: Cascade)
  profiles         profiles         @relation(fields: [profile_id], references: [id], onDelete: Restrict)
  users            users            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  playback_sessions playback_sessions @relation(fields: [playback_session_id], references: [id], onDelete: Cascade)
  media_items      media_items?      @relation(fields: [media_id], references: [id], onDelete: SetNull)

  @@index([account_id])
  @@index([user_id])
  @@index([profile_id])
  @@index([playback_session_id])
  @@map("playback_history")
}

model audit_logs {
  id         String   @id @default(uuid())
  account_id String?
  user_id    String?
  profile_id String?
  device_id  String?
  session_id String?
  category   String
  action     String
  reason     String?
  details    Json?
  ip_address String?
  created_at DateTime @default(now())

  accounts    accounts? @relation(fields: [account_id], references: [id], onDelete: SetNull)
  users       users?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  profiles    profiles? @relation(fields: [profile_id], references: [id], onDelete: SetNull)

  @@index([account_id])
  @@index([user_id])
  @@index([created_at])
  @@map("audit_logs")
}

model system_settings {
  id            String   @id @default(uuid())
  account_id    String
  setting_key   String
  setting_value String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  accounts      accounts @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@unique([account_id, setting_key])
  @@map("system_settings")
}

model system_jobs {
  id        String    @id @default(uuid())
  name      String
  queue_name String
  status    String
  payload   Json?
  attempts  Int       @default(0)
  last_error String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  job_attempts job_attempts[]

  @@index([status])
  @@map("system_jobs")
}

model job_attempts {
  id         String   @id @default(uuid())
  job_id     String
  attempt    Int
  status     String
  started_at DateTime @default(now())
  finished_at DateTime?
  error      String?

  system_jobs system_jobs @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@index([job_id])
  @@map("job_attempts")
}

model billing_webhook_events {
  id           String   @id @default(uuid())
  provider     String
  event_id     String
  event_type   String
  payload      Json
  processed    Boolean  @default(false)
  retry_count  Int      @default(0)
  last_error   String?
  created_at   DateTime @default(now())
  processed_at DateTime?

  @@unique([provider, event_id])
  @@map("billing_webhook_events")
}
