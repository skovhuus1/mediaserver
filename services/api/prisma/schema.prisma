generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  active
  suspended
  disabled
}

enum UserStatus {
  active
  suspended
  deleted
}

enum SubscriptionStatus {
  pending
  trialing
  active
  past_due
  grace_period
  paused
  canceled
  expired
  suspended
}

enum PlaybackStatus {
  reserving
  active
  paused
  completed
  disconnected
  expired
  failed
  user_stopped
  terminated_by_admin
}

enum MediaType {
  movie
  series
  season
  episode
}

enum LibraryType {
  movie
  series
  mixed
}

enum MediaFileStatus {
  ready
  unreadable
  missing
}

enum LibraryScanStatus {
  queued
  running
  completed
  failed
}

model SystemBootstrap {
  id          String   @id @default("singleton")
  accountId   String   @unique @map("account_id")
  completedAt DateTime @default(now()) @map("completed_at")
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@map("system_bootstrap")
}

model Account {
  id                   String                @id @default(uuid())
  name                 String
  serverName           String                @default("BoltBytes Media") @map("server_name")
  externalUrl          String?               @map("external_url")
  language             String                @default("da")
  timezone             String                @default("Europe/Copenhagen")
  status               AccountStatus         @default(active)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  bootstrap            SystemBootstrap?
  users                User[]
  profiles             Profile[]
  devices              Device[]
  refreshTokens        RefreshToken[]
  plans                Plan[]
  subscriptions        Subscription[]
  entitlementOverrides EntitlementOverride[]
  storageRoots         StorageRoot[]
  libraries            Library[]
  mediaItems           MediaItem[]
  mediaFiles           MediaFile[]
  libraryScans         LibraryScan[]
  playbackSessions     PlaybackSession[]
  playbackHistory      PlaybackHistory[]
  auditLogs            AuditLog[]
  settings             SystemSetting[]
  jobs                 SystemJob[]

  @@map("accounts")
}

model User {
  id                   String                @id @default(uuid())
  accountId            String                @map("account_id")
  email                String
  passwordHash         String                @map("password_hash")
  displayName          String                @map("display_name")
  status               UserStatus            @default(active)
  mustChangePassword   Boolean               @default(false) @map("must_change_password")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  account              Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  profiles             Profile[]
  roles                UserRole[]
  devices              Device[]
  refreshTokens        RefreshToken[]
  subscriptions        Subscription[]
  entitlementOverrides EntitlementOverride[]
  playbackSessions     PlaybackSession[]
  playbackHistory      PlaybackHistory[]
  auditLogs            AuditLog[]

  @@unique([accountId, email])
  @@index([accountId, status])
  @@map("users")
}

model Profile {
  id                   String                @id @default(uuid())
  accountId            String                @map("account_id")
  userId               String                @map("user_id")
  name                 String
  isChildProfile       Boolean               @default(false) @map("is_child_profile")
  pinHash              String?               @map("pin_hash")
  language             String                @default("da")
  avatarKey            String?               @map("avatar_key")
  archivedAt           DateTime?             @map("archived_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  account              Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  entitlementOverrides EntitlementOverride[]
  playbackSessions     PlaybackSession[]
  playbackHistory      PlaybackHistory[]
  auditLogs            AuditLog[]

  @@index([accountId, userId])
  @@index([accountId, userId, archivedAt])
  @@map("profiles")
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Device {
  id               String            @id @default(uuid())
  accountId        String            @map("account_id")
  userId           String            @map("user_id")
  fingerprint      String
  name             String
  type             String
  platform         String?
  appVersion       String?           @map("app_version")
  capabilities     Json              @default("{}")
  qualityMode      String            @default("auto") @map("quality_mode")
  fixedQualityHeight Int?            @map("fixed_quality_height")
  allowUpscale     Boolean           @default(true) @map("allow_upscale")
  dataSaver        Boolean           @default(false) @map("data_saver")
  playbackRate     Float             @default(1) @map("playback_rate")
  hdrMode          String            @default("auto") @map("hdr_mode")
  isRevoked        Boolean           @default(false) @map("is_revoked")
  firstSeenAt      DateTime          @default(now()) @map("first_seen_at")
  lastSeenAt       DateTime          @default(now()) @map("last_seen_at")
  account          Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens    RefreshToken[]
  playbackSessions PlaybackSession[]

  @@unique([userId, fingerprint])
  @@index([accountId, userId])
  @@map("devices")
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id")
  accountId  String    @map("account_id")
  userId     String    @map("user_id")
  deviceId   String    @map("device_id")
  profileId  String?   @map("profile_id")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId, deviceId])
  @@index([profileId, revokedAt])
  @@map("refresh_tokens")
}

model Plan {
  id           String        @id @default(uuid())
  accountId    String        @map("account_id")
  name         String
  internalCode String        @map("internal_code")
  description  String?
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  versions     PlanVersion[]

  @@unique([accountId, internalCode])
  @@map("plans")
}

model PlanVersion {
  id                   String           @id @default(uuid())
  planId               String           @map("plan_id")
  version              Int
  isActive             Boolean          @default(false) @map("is_active")
  effectiveAt          DateTime         @default(now()) @map("effective_at")
  maxConcurrentStreams Int              @default(1) @map("max_concurrent_streams")
  maxRegisteredDevices Int              @default(1) @map("max_registered_devices")
  maxVideoResolution   Int              @default(1080) @map("max_video_resolution")
  maxVideoBitrate      Int              @default(4000) @map("max_video_bitrate")
  allowDirectPlay      Boolean          @default(true) @map("allow_direct_play")
  allowDirectStream    Boolean          @default(false) @map("allow_direct_stream")
  allowVideoTranscode  Boolean          @default(false) @map("allow_video_transcode")
  allowAudioTranscode  Boolean          @default(false) @map("allow_audio_transcode")
  allowSubtitleBurnIn  Boolean          @default(false) @map("allow_subtitle_burn_in")
  allowChromecast      Boolean          @default(false) @map("allow_chromecast")
  allowOfflineDownload Boolean          @default(false) @map("allow_offline_download")
  releaseDelayMonths   Int              @default(0) @map("release_delay_months")
  releaseDelayDays     Int              @default(0) @map("release_delay_days")
  snapshot             Json
  plan                 Plan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  entitlement          PlanEntitlement?
  subscriptions        Subscription[]

  @@unique([planId, version])
  @@map("plan_versions")
}

model PlanEntitlement {
  id            String      @id @default(uuid())
  planVersionId String      @unique @map("plan_version_id")
  snapshot      Json
  createdAt     DateTime    @default(now()) @map("created_at")
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@map("plan_entitlements")
}

model Subscription {
  id            String                @id @default(uuid())
  accountId     String                @map("account_id")
  userId        String                @map("user_id")
  planVersionId String                @map("plan_version_id")
  status        SubscriptionStatus    @default(pending)
  startsAt      DateTime              @default(now()) @map("starts_at")
  endsAt        DateTime?             @map("ends_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  account       Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  planVersion   PlanVersion           @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  events        SubscriptionEvent[]
  snapshot      SubscriptionSnapshot?

  @@index([accountId, userId, status])
  @@map("subscriptions")
}

model SubscriptionEvent {
  id             String       @id @default(uuid())
  subscriptionId String       @map("subscription_id")
  type           String
  payload        Json
  createdAt      DateTime     @default(now()) @map("created_at")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("subscription_events")
}

model SubscriptionSnapshot {
  id             String       @id @default(uuid())
  subscriptionId String       @unique @map("subscription_id")
  snapshot       Json
  createdAt      DateTime     @default(now()) @map("created_at")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_snapshots")
}

model EntitlementOverride {
  id        String    @id @default(uuid())
  accountId String    @map("account_id")
  userId    String    @map("user_id")
  profileId String?   @map("profile_id")
  values    Json
  reason    String
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile   Profile?  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([accountId, userId, profileId])
  @@map("user_entitlement_overrides")
}

model StorageRoot {
  id         String      @id @default(uuid())
  accountId  String      @map("account_id")
  label      String
  mountPath  String      @map("mount_path")
  type       String      @default("local")
  isReadOnly Boolean     @default(true) @map("is_read_only")
  createdAt  DateTime    @default(now()) @map("created_at")
  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  libraries  Library[]
  mediaFiles MediaFile[]

  @@unique([accountId, label])
  @@map("storage_roots")
}

model Library {
  id            String        @id @default(uuid())
  accountId     String        @map("account_id")
  storageRootId String        @map("storage_root_id")
  name          String
  type          LibraryType
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  storageRoot   StorageRoot   @relation(fields: [storageRootId], references: [id], onDelete: Restrict)
  paths         LibraryPath[]
  mediaItems    MediaItem[]
  mediaFiles    MediaFile[]
  scans         LibraryScan[]

  @@index([accountId])
  @@map("libraries")
}

model LibraryPath {
  id        String  @id @default(uuid())
  libraryId String  @map("library_id")
  path      String
  recursive Boolean @default(true)
  library   Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@unique([libraryId, path])
  @@map("library_paths")
}

model MediaItem {
  id                   String            @id @default(uuid())
  accountId            String            @map("account_id")
  libraryId            String            @map("library_id")
  title                String
  type                 MediaType
  codec                String?
  container            String?
  bitrate              Int?
  width                Int?
  height               Int?
  category             String?
  seriesTitle          String?           @map("series_title")
  seriesDisplayTitle   String?           @map("series_display_title")
  seriesOverview       String?           @map("series_overview")
  seriesMetadataProviderId String?        @map("series_metadata_provider_id")
  seasonNumber         Int?              @map("season_number")
  seasonMetadataProviderId String?        @map("season_metadata_provider_id")
  seasonPosterPath     String?            @map("season_poster_path")
  episodeNumber        Int?              @map("episode_number")
  episodeStillPath     String?            @map("episode_still_path")
  releaseYear          Int?              @map("release_year")
  overview             String?
  rating               Float?
  metadataProvider     String?           @map("metadata_provider")
  metadataProviderId   String?           @map("metadata_provider_id")
  posterPath           String?           @map("poster_path")
  backdropPath         String?           @map("backdrop_path")
  metadataUpdatedAt    DateTime?         @map("metadata_updated_at")
  genres               Json?
  credits              Json?
  similarProviderIds   Json?             @map("similar_provider_ids")
  recommendationUpdatedAt DateTime?      @map("recommendation_updated_at")
  releaseDate          DateTime?         @map("release_date")
  availabilityOverride DateTime?         @map("availability_override")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  account              Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  library              Library           @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  file                 MediaFile?
  playbackSessions     PlaybackSession[]
  playbackHistory      PlaybackHistory[]

  @@index([accountId, type])
  @@index([accountId, category])
  @@index([accountId, seriesTitle, seasonNumber])
  @@index([accountId, seriesMetadataProviderId])
  @@index([accountId, metadataProvider, metadataProviderId])
  @@map("media_items")
}

model MediaFile {
  id             String          @id @default(uuid())
  accountId      String          @map("account_id")
  libraryId      String          @map("library_id")
  storageRootId  String          @map("storage_root_id")
  mediaItemId    String          @unique @map("media_item_id")
  relativePath   String          @map("relative_path")
  sizeBytes      BigInt          @map("size_bytes")
  modifiedAt     DateTime        @map("modified_at")
  status         MediaFileStatus @default(ready)
  container      String?
  videoCodec     String?         @map("video_codec")
  audioCodec     String?         @map("audio_codec")
  width          Int?
  height         Int?
  durationMs     Int?            @map("duration_ms")
  bitrate        Int?
  probe          Json?
  lastSeenScanId String?         @map("last_seen_scan_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  library        Library         @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  storageRoot    StorageRoot     @relation(fields: [storageRootId], references: [id], onDelete: Restrict)
  mediaItem      MediaItem       @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@unique([libraryId, relativePath])
  @@index([libraryId, status])
  @@index([lastSeenScanId])
  @@map("media_files")
}

model LibraryScan {
  id           String            @id @default(uuid())
  accountId    String            @map("account_id")
  libraryId    String            @map("library_id")
  jobId        String?           @unique @map("job_id")
  status       LibraryScanStatus @default(queued)
  filesSeen    Int               @default(0) @map("files_seen")
  filesCreated Int               @default(0) @map("files_created")
  filesUpdated Int               @default(0) @map("files_updated")
  filesMissing Int               @default(0) @map("files_missing")
  errors       Int               @default(0)
  error        String?
  startedAt    DateTime?         @map("started_at")
  finishedAt   DateTime?         @map("finished_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  library      Library           @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@index([libraryId, createdAt])
  @@index([accountId, status])
  @@map("library_scans")
}

model PlaybackSession {
  id               String             @id @default(uuid())
  accountId        String             @map("account_id")
  userId           String             @map("user_id")
  profileId        String             @map("profile_id")
  deviceId         String             @map("device_id")
  mediaId          String             @map("media_id")
  logicalSessionId String             @map("logical_session_id")
  method           String
  status           PlaybackStatus     @default(reserving)
  streamTokenHash  String             @unique @map("stream_token_hash")
  isCastSession    Boolean            @default(false) @map("is_cast_session")
  runtimeState     String             @default("starting") @map("runtime_state")
  positionMs       Int                @default(0) @map("position_ms")
  durationMs       Int?               @map("duration_ms")
  currentBitrate   Int?               @map("current_bitrate")
  currentHeight    Int?               @map("current_height")
  bufferAheadMs    Int?               @map("buffer_ahead_ms")
  leaseExpiresAt   DateTime           @map("lease_expires_at")
  lastHeartbeatAt  DateTime           @default(now()) @map("last_heartbeat_at")
  startedAt        DateTime           @default(now()) @map("started_at")
  endedAt          DateTime?          @map("ended_at")
  account          Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  profile          Profile            @relation(fields: [profileId], references: [id], onDelete: Restrict)
  device           Device             @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  media            MediaItem          @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  reservation      StreamReservation?
  history          PlaybackHistory[]

  @@index([userId, status, leaseExpiresAt])
  @@index([accountId, status])
  @@map("playback_sessions")
}

model StreamReservation {
  id                String          @id @default(uuid())
  playbackSessionId String          @unique @map("playback_session_id")
  accountId         String          @map("account_id")
  userId            String          @map("user_id")
  reservedAt        DateTime        @default(now()) @map("reserved_at")
  releasedAt        DateTime?       @map("released_at")
  reason            String?
  playbackSession   PlaybackSession @relation(fields: [playbackSessionId], references: [id], onDelete: Cascade)

  @@index([userId, releasedAt])
  @@map("stream_reservations")
}

model PlaybackHistory {
  id                String          @id @default(uuid())
  accountId         String          @map("account_id")
  userId            String          @map("user_id")
  profileId         String          @map("profile_id")
  mediaId           String          @map("media_id")
  playbackSessionId String          @map("playback_session_id")
  positionMs        Int             @default(0) @map("position_ms")
  completed         Boolean         @default(false)
  updatedAt         DateTime        @updatedAt @map("updated_at")
  account           Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile           Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  media             MediaItem       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  playbackSession   PlaybackSession @relation(fields: [playbackSessionId], references: [id], onDelete: Cascade)

  @@unique([profileId, mediaId])
  @@map("playback_history")
}

model ProfilePreferences {
  profileId                  String    @id @map("profile_id")
  accountId                  String    @map("account_id")
  preferredAudioLanguages    Json      @map("preferred_audio_languages")
  preferredSubtitleLanguages Json      @map("preferred_subtitle_languages")
  subtitleMode               String    @default("auto") @map("subtitle_mode")
  autoplayNext               Boolean   @default(true) @map("autoplay_next")
  recommendationsEnabled     Boolean   @default(true) @map("recommendations_enabled")
  recommendationResetAt      DateTime? @map("recommendation_reset_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@index([accountId])
  @@map("profile_preferences")
}

model RecommendationFeedback {
  id        String   @id @default(uuid())
  accountId String   @map("account_id")
  profileId String   @map("profile_id")
  mediaId   String   @map("media_id")
  type      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([profileId, mediaId])
  @@index([accountId, profileId, type])
  @@map("recommendation_feedback")
}

model BillingWebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventId     String    @map("event_id")
  type        String
  payload     Json
  signatureOk Boolean   @default(false) @map("signature_ok")
  processedAt DateTime? @map("processed_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("billing_webhook_events")
}

model AuditLog {
  id            String   @id @default(uuid())
  accountId     String   @map("account_id")
  userId        String?  @map("user_id")
  profileId     String?  @map("profile_id")
  correlationId String?  @map("correlation_id")
  action        String
  outcome       String
  code          String
  details       Json?
  createdAt     DateTime @default(now()) @map("created_at")
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile       Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id        String   @id @default(uuid())
  accountId String   @map("account_id")
  key       String
  value     Json
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, key])
  @@map("system_settings")
}

model SystemJob {
  id             String       @id @default(uuid())
  accountId      String       @map("account_id")
  type           String
  status         String
  payload        Json
  availableAt    DateTime     @default(now()) @map("available_at")
  lockedAt       DateTime?    @map("locked_at")
  leaseExpiresAt DateTime?    @map("lease_expires_at")
  workerId       String?      @map("worker_id")
  attemptCount   Int          @default(0) @map("attempt_count")
  maxAttempts    Int          @default(5) @map("max_attempts")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  attempts       JobAttempt[]

  @@index([status, availableAt, leaseExpiresAt])
  @@map("system_jobs")
}

model JobAttempt {
  id        String    @id @default(uuid())
  jobId     String    @map("job_id")
  number    Int
  status    String
  error     String?
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  job       SystemJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, number])
  @@map("job_attempts")
}
