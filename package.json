{
  "name": "bb-media-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
  "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
  "dev:api": "npm run start:dev --workspace=services/api",
  "dev:web": "npm run dev --workspace=web/admin",
  "build": "npm run build:api && npm run build:web",
  "build:api": "npm run build --workspace=services/api",
  "build:web": "npm run build --workspace=web/admin",
  "lint": "npm run lint --workspace=services/api && npm run lint --workspace=web/admin",
  "typecheck": "npm run build:api && npm run lint --workspace=web/admin",
  "test": "npm run test --workspace=services/api",
  "env:bootstrap": "node scripts/bootstrap-env.mjs"
  },
  "workspaces": [
    "services/*",
    "web/*",
    "shared/*"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  ]
}
